<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_navigation"
    app:startDestination="@id/welcomeFragment">

    <fragment
        android:id="@+id/welcomeFragment"
        android:name="com.dubby.numericalcomposition.presentation.WelcomeFragment"
        android:label="WelcomeFragment">
        <action
            android:id="@+id/action_welcomeFragment_to_chooseLevelFragment2"
            app:destination="@id/chooseLevelFragment2" />
    </fragment>
    <fragment
        android:id="@+id/chooseLevelFragment2"
        android:name="com.dubby.numericalcomposition.presentation.ChooseLevelFragment"
        android:label="fragment_choose_level"
        tools:layout="@layout/fragment_choose_level">
        <action
            android:id="@+id/action_chooseLevelFragment2_to_gameFragment2"
            app:destination="@id/gameFragment2" />
    </fragment>
    <fragment
        android:id="@+id/gameFragment2"
        android:name="com.dubby.numericalcomposition.presentation.GameFragment"
        android:label="fragment_game"
        tools:layout="@layout/fragment_game">
        <action
            android:id="@+id/action_gameFragment2_to_gameFinishFragment"
            app:destination="@id/gameFinishFragment"
            app:popUpTo="@id/gameFragment2"
            app:popUpToInclusive="true" />
        <argument
            android:name="level"
            app:argType="com.dubby.numericalcomposition.domain.entity.Level" />
    </fragment>
    <fragment
        android:id="@+id/gameFinishFragment"
        android:name="com.dubby.numericalcomposition.presentation.GameFinishFragment"
        android:label="fragment_game_finish"
        tools:layout="@layout/fragment_game_finish">
        <argument
            android:name="gameResult"
            app:argType="com.dubby.numericalcomposition.domain.entity.GameResult" />
    </fragment>
</navigation>